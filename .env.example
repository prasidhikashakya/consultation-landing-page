# Set this to your deployed origin before production, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Add the real Vimeo page URL when your video is ready. Only Vimeo URLs are embedded.
NEXT_PUBLIC_VIMEO_URL=

# Secure server-side lead endpoint. It must validate/store the lead and return a 2xx response.
LEAD_SUBMISSION_URL=
LEAD_SUBMISSION_TOKEN=

# Set to "true" only after the backend endpoint is configured and verified.
NEXT_PUBLIC_FORM_LIVE=
