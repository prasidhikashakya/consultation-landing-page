# Set this to your deployed origin before production, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Add the real Vimeo page URL when your video is ready. Only Vimeo URLs are embedded.
NEXT_PUBLIC_VIMEO_URL=

# Spreadsheet ID is an identifier, not an authentication secret.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=

# Paste the ROTATED service-account JSON only in a server-side secret store such as Vercel.
# Do not commit a populated .env.local or put credentials in NEXT_PUBLIC_* variables.
GOOGLE_SERVICE_ACCOUNT_JSON=

# SMTP settings for the professional cPanel mailbox.
SMTP_PORT=465
SMTP_HOST=mail.prasidhikashakya.com.np
SMTP_USER=mail@prasidhikashakya.com.np
SMTP_PASSWORD=
SMTP_FROM=mail@prasidhikashakya.com.np

# Receives the new-lead notification. Defaults to the Google Sheet owner's email.
LEAD_NOTIFICATION_TO=prasidhikashakya@gmail.com

# Optional: include a booking button in the client confirmation email.
CALENDLY_URL=

# Set to "true" only after Google Sheets and SMTP configuration have been verified.
NEXT_PUBLIC_FORM_LIVE=
